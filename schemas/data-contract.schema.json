{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.driftframe.org/site-reading-governance/v3.0/data-contract.schema.json",
  "title": "Database Data Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "representation_id",
    "data_contract_id",
    "version",
    "contract_digest",
    "contract_digest_scope",
    "title",
    "purpose",
    "status",
    "database",
    "isolation_policy",
    "identity_profiles",
    "numeric_profiles",
    "vocabulary_registries",
    "unit_vocabularies",
    "digest_profiles",
    "write_policies",
    "entities",
    "compatibility",
    "invalidation_triggers",
    "metadata"
  ],
  "properties": {
    "representation_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "data_contract_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "contract_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "contract_digest_scope": {
      "type": "string",
      "enum": [
        "governance_canonical_json_v1_excluding_contract_digest"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },
    "purpose": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "superseded"
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_family",
        "engine_version",
        "supported_major_versions",
        "extensions",
        "collation",
        "database_timezone",
        "canonical_json_profile",
        "settings_digest",
        "migration_history_table"
      ],
      "properties": {
        "engine_family": {
          "type": "string",
          "enum": [
            "postgresql",
            "mysql",
            "mariadb",
            "oracle",
            "sqlserver",
            "sqlite",
            "other"
          ]
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "supported_major_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          }
        },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "maxLength": 120
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "collation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "database_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "canonical_json_profile": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "settings_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "migration_history_table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)?$",
          "maxLength": 120
        }
      }
    },
    "isolation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolation_policy_id",
        "tenant_identity_profile_id",
        "ownership_model",
        "row_security_mode",
        "session_context_binding",
        "access_posture",
        "privileged_operation_boundary",
        "verification_digest"
      ],
      "properties": {
        "isolation_policy_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "tenant_identity_profile_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "ownership_model": {
          "type": "string",
          "enum": [
            "tenant_composite_identity"
          ]
        },
        "row_security_mode": {
          "type": "string",
          "enum": [
            "forced_row_level_security"
          ]
        },
        "session_context_binding": {
          "type": "string",
          "enum": [
            "authenticated_tenant_context"
          ]
        },
        "access_posture": {
          "type": "string",
          "enum": [
            "policy_authorized_only"
          ]
        },
        "privileged_operation_boundary": {
          "type": "string",
          "enum": [
            "accountable_migration_and_support_roles"
          ]
        },
        "verification_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "identity_profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity_profile_id",
          "identity_kind",
          "physical_type",
          "normalization",
          "comparison_semantics"
        ],
        "properties": {
          "identity_profile_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "identity_kind": {
            "type": "string",
            "enum": [
              "internal_uuid",
              "external_constrained"
            ]
          },
          "physical_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "normalization": {
            "type": "string",
            "enum": [
              "canonical_uuid",
              "unicode_nfc_preserve_case_trim_outer_whitespace"
            ]
          },
          "comparison_semantics": {
            "type": "string",
            "enum": [
              "uuid_equality",
              "bytewise_text_equality"
            ]
          },
          "maximum_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "collation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "value_pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "namespace_components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 120
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "identity_kind": {
                  "const": "internal_uuid"
                }
              },
              "required": [
                "identity_kind"
              ]
            },
            "then": {
              "properties": {
                "physical_type": {
                  "const": "uuid"
                },
                "normalization": {
                  "const": "canonical_uuid"
                },
                "comparison_semantics": {
                  "const": "uuid_equality"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "identity_kind": {
                  "const": "external_constrained"
                }
              },
              "required": [
                "identity_kind"
              ]
            },
            "then": {
              "required": [
                "maximum_length",
                "collation",
                "value_pattern",
                "namespace_components"
              ]
            }
          }
        ]
      }
    },
    "numeric_profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numeric_profile_id",
          "version",
          "representation_role",
          "assay_code",
          "analyte_code",
          "method_revision",
          "physical_type",
          "precision",
          "scale",
          "finite_required",
          "rounding_mode",
          "rounding_scale",
          "source_lexeme_policy"
        ],
        "properties": {
          "numeric_profile_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/semver"
          },
          "representation_role": {
            "type": "string",
            "enum": [
              "source_quantity",
              "canonical_quantity",
              "conversion_factor",
              "reference_interval_bound",
              "detection_limit",
              "quantitation_limit"
            ]
          },
          "assay_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "analyte_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "method_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "physical_type": {
            "type": "string",
            "pattern": "^(?:numeric|decimal)\\([1-9][0-9]*,[0-9]+\\)$",
            "maxLength": 120
          },
          "precision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "finite_required": {
            "const": true
          },
          "lower_bound": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
            "maxLength": 200
          },
          "upper_bound": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
            "maxLength": 200
          },
          "rounding_mode": {
            "type": "string",
            "enum": [
              "half_even",
              "half_up",
              "toward_zero",
              "exact"
            ]
          },
          "rounding_scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "source_lexeme_policy": {
            "type": "string",
            "enum": [
              "preserved_for_trace",
              "canonical_decimal_only"
            ]
          }
        }
      }
    },
    "vocabulary_registries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vocabulary_registry_id",
          "system_name",
          "canonical_uri",
          "release",
          "content_digest",
          "resolution_policy",
          "unknown_code_policy"
        ],
        "properties": {
          "vocabulary_registry_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "system_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "canonical_uri": {
            "type": "string",
            "pattern": "^https://\\S+$",
            "maxLength": 500
          },
          "release": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "content_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "resolution_policy": {
            "type": "string",
            "enum": [
              "exact_code_in_pinned_release"
            ]
          },
          "unknown_code_policy": {
            "type": "string",
            "enum": [
              "owned_exception_queue"
            ]
          }
        }
      }
    },
    "unit_vocabularies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_vocabulary_id",
          "vocabulary_registry_id",
          "system",
          "version",
          "canonical_code_pattern",
          "mapping_scope",
          "source_unit_policy",
          "mapping_revision_required",
          "exception_route"
        ],
        "properties": {
          "unit_vocabulary_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "vocabulary_registry_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "system": {
            "type": "string",
            "enum": [
              "UCUM",
              "organization_controlled"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "canonical_code_pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "mapping_scope": {
            "type": "string",
            "enum": [
              "assay_analyte_method_revision"
            ]
          },
          "source_unit_policy": {
            "type": "string",
            "enum": [
              "preserve_source_and_canonical"
            ]
          },
          "mapping_revision_required": {
            "const": true
          },
          "exception_route": {
            "type": "string",
            "enum": [
              "owned_mapping_review"
            ]
          }
        }
      }
    },
    "digest_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "digest_profile_id",
          "algorithm",
          "physical_type",
          "byte_length",
          "canonicalization_profile",
          "content_scope",
          "envelope_schema_version"
        ],
        "properties": {
          "digest_profile_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "sha-256",
              "sha-384",
              "sha-512"
            ]
          },
          "physical_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "byte_length": {
            "type": "integer",
            "minimum": 16,
            "maximum": 128
          },
          "canonicalization_profile": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "content_scope": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "envelope_schema_version": {
            "$ref": "common.schema.json#/$defs/semver"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "algorithm": {
                  "const": "sha-256"
                }
              },
              "required": [
                "algorithm"
              ]
            },
            "then": {
              "properties": {
                "byte_length": {
                  "const": 32
                }
              }
            }
          }
        ]
      }
    },
    "write_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "write_policy_id",
          "mutation_model",
          "application_write_path",
          "table_privilege_posture",
          "original_record_policy",
          "correction_model",
          "concurrency_control",
          "verification_digest"
        ],
        "properties": {
          "write_policy_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "mutation_model": {
            "type": "string",
            "enum": [
              "version_guarded_projection",
              "append_only_ledger",
              "controlled_reference_data"
            ]
          },
          "application_write_path": {
            "type": "string",
            "enum": [
              "service_owned_operation",
              "database_owned_operation"
            ]
          },
          "table_privilege_posture": {
            "type": "string",
            "enum": [
              "controlled_boundary_only"
            ]
          },
          "original_record_policy": {
            "type": "string",
            "enum": [
              "retained_with_lineage"
            ]
          },
          "correction_model": {
            "type": "string",
            "enum": [
              "versioned_transition",
              "superseding_record"
            ]
          },
          "concurrency_control": {
            "type": "string",
            "enum": [
              "expected_version_guard",
              "idempotent_append_guard"
            ]
          },
          "verification_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "table_name",
          "purpose",
          "data_class",
          "retention_class",
          "tenant_scope",
          "write_policy_id",
          "fields",
          "primary_key_field_ids",
          "constraints",
          "quantity_bindings"
        ],
        "properties": {
          "entity_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "table_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 120
          },
          "purpose": {
            "type": "string",
            "minLength": 10,
            "maxLength": 700
          },
          "data_class": {
            "type": "string",
            "enum": [
              "synthetic",
              "public",
              "internal",
              "confidential",
              "regulated"
            ]
          },
          "retention_class": {
            "type": "string",
            "minLength": 2,
            "maxLength": 96
          },
          "tenant_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope_mode",
              "row_security_mode",
              "policy_name",
              "policy_digest"
            ],
            "properties": {
              "scope_mode": {
                "type": "string",
                "enum": [
                  "tenant_owned",
                  "global_reference"
                ]
              },
              "tenant_field_id": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "composite_identity_required": {
                "type": "boolean"
              },
              "row_security_mode": {
                "type": "string",
                "enum": [
                  "forced_row_level_security",
                  "global_reference_acl"
                ]
              },
              "context_binding": {
                "type": "string",
                "enum": [
                  "authenticated_tenant_context",
                  "accountable_global_role"
                ]
              },
              "policy_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 120
              },
              "policy_digest": {
                "$ref": "common.schema.json#/$defs/digest"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "scope_mode": {
                      "const": "tenant_owned"
                    }
                  },
                  "required": [
                    "scope_mode"
                  ]
                },
                "then": {
                  "required": [
                    "tenant_field_id",
                    "composite_identity_required",
                    "context_binding"
                  ],
                  "properties": {
                    "composite_identity_required": {
                      "const": true
                    },
                    "row_security_mode": {
                      "const": "forced_row_level_security"
                    },
                    "context_binding": {
                      "const": "authenticated_tenant_context"
                    }
                  }
                }
              }
            ]
          },
          "write_policy_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field_id",
                "column_name",
                "semantic_type",
                "physical_type",
                "nullable",
                "source_of_truth",
                "description"
              ],
              "properties": {
                "field_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "column_name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 120
                },
                "semantic_type": {
                  "type": "string",
                  "enum": [
                    "identifier",
                    "instant",
                    "civil_date",
                    "local_date_time",
                    "exact_decimal",
                    "integer",
                    "boolean",
                    "text",
                    "controlled_term",
                    "json_document",
                    "binary_reference",
                    "scientific_unit",
                    "content_digest"
                  ]
                },
                "physical_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "nullable": {
                  "type": "boolean"
                },
                "source_of_truth": {
                  "type": "string",
                  "enum": [
                    "database",
                    "upstream_system",
                    "derived"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 700
                },
                "default_expression_digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                },
                "generated_expression_digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                },
                "identity_profile_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "numeric_profile_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "quantity_role": {
                  "type": "string",
                  "enum": [
                    "source_value",
                    "canonical_value",
                    "conversion_factor",
                    "reference_interval_bound",
                    "detection_limit",
                    "quantitation_limit"
                  ]
                },
                "unit_vocabulary_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "unit_role": {
                  "type": "string",
                  "enum": [
                    "source_label",
                    "canonical_code"
                  ]
                },
                "digest_profile_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "temporal_semantics": {
                  "type": "string",
                  "enum": [
                    "absolute_instant",
                    "civil_date",
                    "civil_local_date_time"
                  ]
                },
                "temporal_role": {
                  "type": "string",
                  "enum": [
                    "occurrence_time",
                    "recording_time",
                    "effective_time",
                    "expiry_time"
                  ]
                },
                "finite_required": {
                  "type": "boolean"
                },
                "source_representation_field_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "controlled_vocabulary_id": {
                  "$ref": "common.schema.json#/$defs/identifier"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "semantic_type": {
                        "const": "identifier"
                      }
                    },
                    "required": [
                      "semantic_type"
                    ]
                  },
                  "then": {
                    "required": [
                      "identity_profile_id"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "semantic_type": {
                        "const": "exact_decimal"
                      }
                    },
                    "required": [
                      "semantic_type"
                    ]
                  },
                  "then": {
                    "required": [
                      "numeric_profile_id",
                      "quantity_role"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "semantic_type": {
                        "const": "instant"
                      }
                    },
                    "required": [
                      "semantic_type"
                    ]
                  },
                  "then": {
                    "required": [
                      "temporal_semantics",
                      "temporal_role",
                      "finite_required"
                    ],
                    "properties": {
                      "temporal_semantics": {
                        "const": "absolute_instant"
                      },
                      "finite_required": {
                        "const": true
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "semantic_type": {
                        "const": "civil_date"
                      }
