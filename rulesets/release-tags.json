{
  "name": "semantic-release-tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v*",
        "refs/tags/spec-v*",
        "refs/tags/candidate-v*",
        "refs/tags/governance-v*",
        "refs/tags/comparison-v*",
        "refs/tags/forecast-*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_signatures"
    }
  ],
  "bypass_actors": []
}
