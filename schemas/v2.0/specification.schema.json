{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.driftframe.org/site-reading-governance/v2.0/specification.schema.json",
  "title": "Site Reading Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specification_id",
    "title",
    "version",
    "intent",
    "material_effect",
    "rules",
    "scenario_ids",
    "acceptance_authorities",
    "metadata"
  ],
  "properties": {
    "specification_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 180
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "intent": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "material_effect": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "intended_use_profile": {
      "type": "string",
      "minLength": 5,
      "maxLength": 180
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "desired_state",
          "verification"
        ],
        "properties": {
          "rule_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "desired_state": {
            "type": "string",
            "minLength": 10,
            "maxLength": 700
          },
          "verification": {
            "type": "string",
            "minLength": 10,
            "maxLength": 700
          },
          "boundaries": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/boundary"
            }
          }
        }
      }
    },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "acceptance_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "scientific",
          "quality",
          "regulatory",
          "security_privacy",
          "operations",
          "business"
        ]
      }
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/recordMetadata"
    }
  }
}
