{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.driftframe.org/site-reading-governance/v2.0/receipt.schema.json",
  "title": "Assurance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_family",
    "claim",
    "scope",
    "evidence_mode",
    "assurance_stage",
    "authority",
    "actual_acceptance_required",
    "environment",
    "source",
    "scenario_ids",
    "test_ids",
    "outcome",
    "artifacts",
    "limitations",
    "performed_at",
    "performer",
    "reviewer",
    "retest_triggers",
    "metadata"
  ],
  "properties": {
    "receipt_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "receipt_family": {
      "type": "string",
      "enum": [
        "configured_vendor",
        "migration_restore",
        "security_observability",
        "scientific_acceptance_support",
        "quality_acceptance_support",
        "regulatory_acceptance_support",
        "engineering_verification"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "scope": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "evidence_mode": {
      "$ref": "common.schema.json#/$defs/evidenceMode"
    },
    "assurance_stage": {
      "$ref": "common.schema.json#/$defs/assuranceStage"
    },
    "authority": {
      "type": "string",
      "enum": [
        "simulation_only",
        "engineering",
        "organizational"
      ]
    },
    "actual_acceptance_required": {
      "type": "boolean"
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/environment"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/versionedCoordinate"
    },
    "fixture_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "test_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/metric"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/artifact"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 700
      }
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "performer": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "reviewer": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "accountable_approver": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "retest_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300
      }
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/recordMetadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_mode": {
            "const": "simulated"
          }
        },
        "required": [
          "evidence_mode"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "const": "simulation_only"
          },
          "actual_acceptance_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance_stage": {
            "const": "accepted"
          }
        },
        "required": [
          "assurance_stage"
        ]
      },
      "then": {
        "required": [
          "accountable_approver"
        ],
        "properties": {
          "evidence_mode": {
            "const": "observed"
          },
          "authority": {
            "const": "organizational"
          },
          "actual_acceptance_required": {
            "const": false
          }
        }
      }
    }
  ]
}
