{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.driftframe.org/site-reading-governance/v3.0/coordination-horizon.schema.json",
  "title": "Coordination Horizon Documentation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "horizon_id",
    "title",
    "purpose",
    "runtime_effect",
    "as_of",
    "current",
    "next",
    "later",
    "reentry"
  ],
  "properties": {
    "horizon_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "title": {"type": "string", "minLength": 5, "maxLength": 180},
    "purpose": {"type": "string", "minLength": 20, "maxLength": 1000},
    "runtime_effect": {"type": "string", "const": "none"},
    "as_of": {"type": "string", "format": "date-time"},
    "current": {
      "type": "array",
      "items": {"type": "string", "minLength": 5, "maxLength": 500}
    },
    "next": {
      "type": "array",
      "items": {"type": "string", "minLength": 5, "maxLength": 500}
    },
    "later": {
      "type": "array",
      "items": {"type": "string", "minLength": 5, "maxLength": 500}
    },
    "reentry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state", "next_action", "verification"],
      "properties": {
        "current_state": {"type": "string", "minLength": 10, "maxLength": 700},
        "next_action": {"type": "string", "minLength": 10, "maxLength": 700},
        "verification": {"type": "string", "minLength": 10, "maxLength": 700}
      }
    }
  }
}
